{
  "info": {
    "_postman_id": "adbab1b7-6094-457c-8bd9-0c01b4e91bf3",
    "name": "Veridian Global Advisors API",
    "description": "Requests for the Veridian backend: the public lead-submission endpoint plus the admin endpoints for listing, filtering, updating, deleting, and getting stats on leads. Import the companion Veridian-Local.postman_environment.json (or create your own environment) so {{baseUrl}} and {{adminKey}} resolve. Run 'Submit Lead' at least once before the Admin folder if running requests individually - it saves the created lead's id into {{leadId}}, which 'Update Lead Status' and 'Delete Lead' use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "leadId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Submit Lead' request's test script after a successful submission."
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Liveness check. No authentication required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has status and timestamp\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"status\", \"ok\");",
                  "    pm.expect(json).to.have.property(\"timestamp\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"country\": \"United States\",\n  \"netWorth\": \"$5M\\u2013$20M\",\n  \"tierInterest\": \"Accelerated\",\n  \"email\": \"john@example.com\",\n  \"disclaimerAccepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/submit-lead",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submit-lead"]
            },
            "description": "Public endpoint for submitting a new lead. Rate limited to 5 requests/hour per IP. Submitting the same email again updates that lead instead of creating a duplicate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response indicates success with a leadId\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"success\", true);",
                  "    pm.expect(json).to.have.property(\"leadId\");",
                  "    pm.expect(json.leadId).to.be.a(\"number\");",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "});",
                  "",
                  "pm.test(\"Saves leadId for later requests\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"leadId\", json.leadId);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin (requires adminKey)",
      "item": [
        {
          "name": "Get All Leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leads?key={{adminKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"],
              "query": [
                {
                  "key": "key",
                  "value": "{{adminKey}}"
                }
              ]
            },
            "description": "Lists leads. Requires the admin key (query param shown here, or an x-api-key header)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has a data array and total\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"success\", true);",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json).to.have.property(\"total\");",
                  "    pm.expect(json.total).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Leads Filtered by Status (New)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leads?key={{adminKey}}&status=New",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"],
              "query": [
                {
                  "key": "key",
                  "value": "{{adminKey}}"
                },
                {
                  "key": "status",
                  "value": "New"
                }
              ]
            },
            "description": "Lists leads filtered to a single status. status must be one of: New, Contacted, Consultation Scheduled, Engagement Sent, Signed, Rejected, Converted, Archived."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every returned lead has status New\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    json.data.forEach(function (lead) {",
                  "        pm.expect(lead.status).to.eql(\"New\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/leads/{{leadId}}/status?key={{adminKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads", "{{leadId}}", "status"],
              "query": [
                {
                  "key": "key",
                  "value": "{{adminKey}}"
                }
              ]
            },
            "description": "Updates a lead's status. Uses {{leadId}}, set automatically by the 'Submit Lead' request - override it manually to target a different lead. status must be one of: New, Contacted, Consultation Scheduled, Engagement Sent, Signed, Rejected, Converted, Archived."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Lead status was updated to Contacted\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"success\", true);",
                  "    pm.expect(json.data).to.have.property(\"status\", \"Contacted\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leads/{{leadId}}?key={{adminKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads", "{{leadId}}"],
              "query": [
                {
                  "key": "key",
                  "value": "{{adminKey}}"
                }
              ]
            },
            "description": "Soft-deletes a lead by setting its status to 'Archived'. Uses {{leadId}}, set automatically by the 'Submit Lead' request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response indicates success\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.eql({ success: true });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Lead Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leads/stats?key={{adminKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads", "stats"],
              "query": [
                {
                  "key": "key",
                  "value": "{{adminKey}}"
                }
              ]
            },
            "description": "Returns lead counts grouped by status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has total and a byStatus breakdown\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"success\", true);",
                  "    pm.expect(json.data).to.have.property(\"total\");",
                  "    pm.expect(json.data.total).to.be.a(\"number\");",
                  "    pm.expect(json.data).to.have.property(\"byStatus\");",
                  "    pm.expect(json.data.byStatus).to.be.an(\"object\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
