# Runtime: development, test, or production.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Use separate application and migration roles in production.
DATABASE_URL=postgresql://veridian_app:local_app_password@localhost:5432/veridian
MIGRATION_DATABASE_URL=postgresql://veridian_migrator:local_migration_password@localhost:5432/veridian
TEST_DATABASE_URL=postgresql://veridian_test:local_test_password@localhost:5432/veridian_test

# Generate with at least 32 random bytes. No default is accepted in production.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEYS=v1:replace-with-base64-encoded-32-byte-key
# Separate base64-encoded 32-byte key used only for backup artifacts.
BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-characters

# Same-origin admin/API is the supported default. List exact additional origins only.
PUBLIC_SITE_URL=http://localhost:5000
ADMIN_APP_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
TRUSTED_ORIGINS=http://localhost:5000

COMMUNICATION_POLICY=EMAIL_ONLY
CONSULTATIONS_ENABLED=false
CURRENT_NOTICE_VERSION=2026-09-01
STAFF_NOTIFICATION_EMAIL=staff@example.test
MONITORED_REPLY_TO=reply@example.test
EMAIL_TEST_RECIPIENT=test@example.test

# Development defaults target Mailpit. Production supports resend or smtp.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Veridian Global Advisors <no-reply@example.test>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Private S3-compatible storage. Local values target MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=veridian-private
S3_ACCESS_KEY_ID=veridian-local
S3_SECRET_ACCESS_KEY=replace-local-secret
S3_FORCE_PATH_STYLE=true
MAX_PDF_BYTES=10485760
SCANNER_ADAPTER=development-allow-pdf

# Only configure proxy hops that are controlled by the deployment provider.
TRUST_PROXY_HOPS=0
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=60
