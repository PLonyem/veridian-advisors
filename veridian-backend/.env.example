# Server
PORT=5000
NODE_ENV=development

# Email (Gmail or SendGrid)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Admin
ADMIN_EMAIL=hello@veridianglobal.com
ADMIN_KEY=generate-a-random-32-char-string

# Application
BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Rate limiting for POST /api/submit-lead only (optional - defaults shown below are used if omitted)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5

# Optional - deployment only. Redirects data.db, backups/, and logs/ under this
# directory (e.g. a mounted persistent volume) instead of the project root.
# Leave unset for local development.
# DATA_DIR=/data
