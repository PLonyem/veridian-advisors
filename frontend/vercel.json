{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/admin", "destination": "https://veridian-api.onrender.com/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://veridian-api.onrender.com/api/:path*" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/thank-you", "destination": "/thank-you.html" }
  ]
}
